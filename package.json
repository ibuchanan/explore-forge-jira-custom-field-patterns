{
  "name": "explore-forge-jira-custom-field-patterns",
  "version": "0.1.0",
  "private": true,
  "description": "Forge app exploring Jira custom-field UI Kit patterns.",
  "license": "Apache-2.0",
  "author": "ibuchanan",
  "type": "module",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "changelog": "git cliff --config cliff.toml --unreleased -o CHANGELOG.md",
    "check": "npm run lint && npm run test && npm run size:check",
    "clean": "npm run clean --workspaces --if-present",
    "format": "biome format --write",
    "format:check": "biome format",
    "lint": "npm run lint:check && npm run lint:prelint && npm run lint:forge && npm run typecheck && npm run format:check",
    "lint:check": "biome lint",
    "lint:docs": "markdownlint-cli2 \"**/*.md\" && cspell lint \"**/*.md\"",
    "lint:fix": "biome lint --write",
    "lint:forge": "npm run lint --workspaces --if-present",
    "lint:prelint": "ast-grep scan --globs '!specs/**' --globs '!node_modules/**' --config ./node_modules/@forge-ahead/prelint/sgconfig.ecosol.yml",
    "prepare": "lefthook install || true",
    "size:check": "npm run size:check --workspaces --if-present",
    "test": "vitest run --passWithNoTests",
    "test:coverage": "vitest run --coverage --passWithNoTests",
    "test:watch": "vitest watch --passWithNoTests",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "dependencies": {
    "@forge-ahead/atlassian-api-types": "github:ibuchanan/forge-ahead-atlassian-api-types",
    "@forge-ahead/errors": "github:ibuchanan/forge-ahead-errors",
    "@forge-ahead/logging": "github:ibuchanan/forge-ahead-logging",
    "@forge/react": "^12.3.1",
    "number-to-words": "^1.2",
    "react": "^18.3.1"
  },
  "devDependencies": {
    "@ast-grep/cli": "0.50.0",
    "@biomejs/biome": "2.5.15",
    "@forge-ahead/prelint": "github:ibuchanan/tool-forge-prelint-ast-grep",
    "@size-limit/file": "14.2.0",
    "@types/node": "24",
    "@types/number-to-words": "^1.2",
    "@types/react": "^18.3.31",
    "cspell": "10.3.6",
    "git-cliff": "2.14.2",
    "lefthook": "2.2.2",
    "markdownlint-cli2": "0.23.3",
    "size-limit": "14.2.0",
    "typescript": "^5.9.3",
    "vitest": "^5.0.4"
  }
}
